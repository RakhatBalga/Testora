# Git LFS for future audio only. Nothing is migrated: history is not rewritten
# and the existing backend/static/audio/listening/testora-studio-02.m4a (~10 MB)
# stays a regular blob. Install git-lfs before adding new audio files.
*.m4a filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# Keep the existing file as a plain blob
backend/static/audio/listening/testora-studio-02.m4a -filter -diff -merge -text
